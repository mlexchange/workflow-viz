# Example environment configuration for local testing and validation of the workflow-viz reduction and feature-extraction interface.

# The URI of a container in a Tiled server with raw detector data from a scattering beamline
# Replace <your-value-here> with the URI for such a container.
# Examples are:
# the root container of a local server:
#   'http://127.0.0.1:8888' 
# the 'processed' container of a server running in a docker container:
#   'http://tiled:8000/api/v1/metadata/processed'
TILED_URI=<your-tiled-uri>
# API key for accessing the Tiled server and container from TILED_URI
# Replace <your-tiled-api-key> with your API key, generated by e.g. python -c "import secrets; print(secrets.token_hex(32))"
TILED_API_KEY=<your-tiled-api-key>

# Local data paths for raw and processed data. Tiled will have read-only access to raw data, but read-write access to processed data.
# These paths must match the corresponding values in the .env under SAXSWAXS_workflows
PATH_TO_RAW_DATA=<absolute-path-to-raw-data>
PATH_TO_PROCESSED_DATA=<absolute-path-to-processed-data>

# Tiled catalog paths
PATH_TO_RAW_DATA_CATALOG=./tiled/db/catalog.db
PATH_TO_PROCESSED_DATA_CATALOG=./tiled/db/catalog_processed.db

# Prefect Server configuration
PREFECT_API_URL=http://127.0.0.1:4200/api